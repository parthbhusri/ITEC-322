# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# PostgreSQL connection (psycopg 3 driver)
# Local example:  postgresql+psycopg://postgres:yourpassword@localhost:5432/campus_rental
# Hosted example (Neon/Supabase): paste the connection string they give you,
# changing "postgresql://" at the start to "postgresql+psycopg://"
DATABASE_URL=postgresql+psycopg://postgres:yourpassword@localhost:5432/campus_rental

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-long-random-string

# Stripe TEST mode keys from https://dashboard.stripe.com/test/apikeys
# Leave blank to run without payments (everything else still works).
STRIPE_SECRET_KEY=
# Only needed if you forward webhooks with the Stripe CLI:
#   stripe listen --forward-to localhost:8000/api/payments/webhook
STRIPE_WEBHOOK_SECRET=

# Where the Next.js frontend runs (Stripe sends people back here after paying)
FRONTEND_URL=http://localhost:3000
